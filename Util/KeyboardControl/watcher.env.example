# Optional local overrides for watch_nao.sh.
# Put local values in watcher.env; that file is ignored by the repository.

NAO_WATCHER_IP=192.168.49.2
NAO_WATCHER_CAMERA=dual
NAO_WATCHER_SCALE=1

# Defaults to <repo>/Install/Keys/id_rsa_nao.
# NAO_WATCHER_SSH_KEY=/absolute/path/to/id_rsa_nao

# Defaults to Util/KeyboardControl/.venv.
# NAO_WATCHER_VENV=/absolute/path/to/.venv

# Use a different Python instead of the venv.
# NAO_WATCHER_PYTHON=/absolute/path/to/python3
